generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

enum UserRole {
  END_USER
  VENDOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String     @unique
  phone               String?    @unique
  passwordHash        String     @map("password_hash")
  role                UserRole   @default(END_USER)
  status              UserStatus @default(ACTIVE)
  emailVerifiedAt     DateTime?  @map("email_verified_at")
  phoneVerifiedAt     DateTime?  @map("phone_verified_at")
  lastLoginAt         DateTime?  @map("last_login_at")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  profile                  UserProfile?
  weddingProfile           WeddingProfile?
  adminUser                AdminUser?
  auditLogs                AuditLog[]
  refreshTokens            RefreshToken[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  vendor                   Vendor?
  vendorInvitationsSent    VendorInvitation[]       @relation("VendorInvitationsSent")
  vendorInvitationsClaimed VendorInvitation[]       @relation("VendorInvitationsClaimed")
  vendorStatusChanges      VendorStatusHistory[]
  searchLogs               SearchLog[]
  shortlists               Shortlist[]
  analyticsEvents          AnalyticsEvent[]
  enquiries                Enquiry[]
  leadStatusChanges        LeadStatusHistory[]
  leadNotes                LeadNote[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model UserProfile {
  userId        String   @id @map("user_id") @db.Uuid
  firstName     String?  @map("first_name")
  lastName      String?  @map("last_name")
  avatarUrl     String?  @map("avatar_url")
  avatarMediaId String?  @map("avatar_media_id") @db.Uuid
  cityId        String?  @map("city_id") @db.Uuid
  bio           String?
  preferences   Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarMedia Media? @relation("UserProfileAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)

  @@map("user_profiles")
}

model WeddingProfile {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  weddingDate     DateTime? @map("wedding_date")
  cityId          String?   @map("city_id") @db.Uuid
  venueCityId     String?   @map("venue_city_id") @db.Uuid
  guestCount      Int?      @map("guest_count")
  estimatedBudget Decimal?  @map("estimated_budget") @db.Decimal(12, 2)
  weddingStyle    String?   @map("wedding_style")
  partnerName     String?   @map("partner_name")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wedding_profiles")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  adminUsers      AdminUser[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AdminUser {
  userId    String   @id @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@map("admin_users")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum AttributeDataType {
  BOOLEAN
  NUMBER
  TEXT
  SELECT
  MULTI_SELECT
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  parentId    String?  @map("parent_id") @db.Uuid
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent           Category?           @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Category[]          @relation("CategoryHierarchy")
  attributes       CategoryAttribute[]
  services         Service[]
  vendorCategories VendorCategory[]
  enquiries        Enquiry[]

  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

model CategoryAttribute {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId   String            @map("category_id") @db.Uuid
  key          String
  label        String
  dataType     AttributeDataType @map("data_type")
  options      Json?
  isFilterable Boolean           @default(false) @map("is_filterable")
  isComparable Boolean           @default(false) @map("is_comparable")
  sortOrder    Int               @default(0) @map("sort_order")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  vendorAttributeValues VendorAttributeValue[]

  @@unique([categoryId, key])
  @@map("category_attributes")
}

enum LocationType {
  COUNTRY
  STATE
  CITY
  AREA
}

model Location {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      LocationType
  name      String
  slug      String
  parentId  String?      @map("parent_id") @db.Uuid
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  parent                 Location?           @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children               Location[]          @relation("LocationHierarchy")
  vendorsWithPrimaryCity Vendor[]            @relation("VendorPrimaryCity")
  vendorServiceAreas     VendorServiceArea[]
  enquiries              Enquiry[]

  @@unique([parentId, slug])
  @@index([type])
  @@index([parentId])
  @@map("locations")
}

enum VendorStatus {
  DRAFT
  PENDING_VERIFICATION
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
  DEACTIVATED
}

enum VerificationLevel {
  UNVERIFIED
  IDENTITY_VERIFIED
  BUSINESS_VERIFIED
  PLATFORM_VERIFIED
}

enum VendorCreationSource {
  SELF_REGISTERED
  ADMIN_CREATED
}

model Vendor {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId         String?              @unique @map("owner_user_id") @db.Uuid
  businessName        String               @map("business_name")
  slug                String               @unique
  status              VendorStatus         @default(DRAFT)
  creationSource      VendorCreationSource @map("creation_source")
  verificationLevel   VerificationLevel    @default(UNVERIFIED) @map("verification_level")
  cityId              String?              @map("city_id") @db.Uuid
  rejectionReason     String?              @map("rejection_reason")
  suspensionReason    String?              @map("suspension_reason")
  approvedAt          DateTime?            @map("approved_at")
  submittedAt         DateTime?            @map("submitted_at")
  profileCompleteness Int                  @default(0) @map("profile_completeness")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")

  owner           User?                  @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  city            Location?              @relation("VendorPrimaryCity", fields: [cityId], references: [id], onDelete: SetNull)
  profile         VendorProfile?
  categories      VendorCategory[]
  serviceAreas    VendorServiceArea[]
  attributeValues VendorAttributeValue[]
  services        VendorService[]
  packages        Package[]
  invitations     VendorInvitation[]
  statusHistory   VendorStatusHistory[]
  media           Media[]
  albums          Album[]
  shortlistItems  ShortlistItem[]
  leads           Lead[]

  @@index([status])
  @@index([cityId])
  @@index([ownerUserId])
  @@index([status, cityId])
  // GIN trigram index for pg_trgm fuzzy keyword search (Arch Phase 7). Needs
  // the postgresqlExtensions preview feature (see generator/datasource
  // blocks above) since `ops: gin_trgm_ops` isn't expressible otherwise —
  // first attempted as untracked raw SQL, which a later migration's drift
  // detection silently dropped, so this is now first-class schema state.
  @@index([businessName(ops: raw("gin_trgm_ops"))], type: Gin, name: "vendors_business_name_trgm_idx")
  @@map("vendors")
}

model VendorProfile {
  vendorId             String   @id @map("vendor_id") @db.Uuid
  shortDescription     String?  @map("short_description")
  description          String?
  logoMediaId          String?  @map("logo_media_id") @db.Uuid
  coverMediaId         String?  @map("cover_media_id") @db.Uuid
  vendorType           String?  @map("vendor_type")
  tags                 String[] @default([])
  address              String?
  latitude             Decimal? @db.Decimal(9, 6)
  longitude            Decimal? @db.Decimal(9, 6)
  startingPrice        Decimal? @map("starting_price") @db.Decimal(12, 2)
  priceRangeMin        Decimal? @map("price_range_min") @db.Decimal(12, 2)
  priceRangeMax        Decimal? @map("price_range_max") @db.Decimal(12, 2)
  currency             String   @default("INR")
  customQuoteAvailable Boolean  @default(false) @map("custom_quote_available")
  yearsExperience      Int?     @map("years_experience")
  teamSize             Int?     @map("team_size")
  languages            String[] @default([])
  travelPolicy         String?  @map("travel_policy")
  website              String?
  phone                String?
  email                String?
  socialLinks          Json?    @map("social_links")
  businessHours        Json?    @map("business_hours")
  availabilityNotes    String?  @map("availability_notes")
  seoTitle             String?  @map("seo_title")
  seoDescription       String?  @map("seo_description")
  canonicalUrl         String?  @map("canonical_url")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  vendor     Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  logoMedia  Media? @relation("VendorProfileLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  coverMedia Media? @relation("VendorProfileCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  @@index([startingPrice])
  // GIN trigram indexes power Arch Phase 7's fuzzy keyword search across
  // vendor descriptions. The tags[] index uses the default array GIN ops
  // (containment/overlap, e.g. `tags && ARRAY[...]`), not gin_trgm_ops —
  // trigram ops are for text similarity, not array membership.
  @@index([shortDescription(ops: raw("gin_trgm_ops"))], type: Gin, name: "vendor_profiles_short_description_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, name: "vendor_profiles_description_trgm_idx")
  @@index([tags], type: Gin, name: "vendor_profiles_tags_gin_idx")
  @@map("vendor_profiles")
}

model VendorCategory {
  vendorId   String   @map("vendor_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([vendorId, categoryId])
  @@index([categoryId])
  @@map("vendor_categories")
}

model VendorServiceArea {
  vendorId   String   @map("vendor_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([vendorId, locationId])
  @@index([locationId])
  @@map("vendor_service_areas")
}

model VendorAttributeValue {
  vendorId     String   @map("vendor_id") @db.Uuid
  attributeId  String   @map("attribute_id") @db.Uuid
  valueText    String?  @map("value_text")
  valueNumber  Decimal? @map("value_number") @db.Decimal(14, 4)
  valueBoolean Boolean? @map("value_boolean")
  valueOptions String[] @default([]) @map("value_options")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  vendor    Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  attribute CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([vendorId, attributeId])
  @@map("vendor_attribute_values")
}

model Service {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String
  slug        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  vendorServices VendorService[]
  enquiries      Enquiry[]

  @@unique([categoryId, slug])
  @@map("services")
}

model VendorService {
  vendorId  String   @map("vendor_id") @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([vendorId, serviceId])
  @@index([serviceId])
  @@map("vendor_services")
}

model Package {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("INR")
  inclusions  String[] @default([])
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("packages")
}

model VendorInvitation {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId         String    @map("vendor_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash")
  invitedEmail     String?   @map("invited_email")
  invitedByAdminId String    @map("invited_by_admin_id") @db.Uuid
  expiresAt        DateTime  @map("expires_at")
  usedAt           DateTime? @map("used_at")
  claimedByUserId  String?   @map("claimed_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")

  vendor         Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  invitedByAdmin User   @relation("VendorInvitationsSent", fields: [invitedByAdminId], references: [id], onDelete: Restrict)
  claimedByUser  User?  @relation("VendorInvitationsClaimed", fields: [claimedByUserId], references: [id], onDelete: SetNull)

  @@index([vendorId])
  @@map("vendor_invitations")
}

model VendorStatusHistory {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId        String        @map("vendor_id") @db.Uuid
  fromStatus      VendorStatus? @map("from_status")
  toStatus        VendorStatus  @map("to_status")
  reason          String?
  changedByUserId String?       @map("changed_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")

  vendor    Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  changedBy User?  @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([vendorId])
  @@map("vendor_status_history")
}

enum MediaType {
  LOGO
  COVER
  PORTFOLIO
  VIDEO
}

enum MediaStatus {
  PENDING
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETED
}

enum MediaModerationStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum AlbumVisibility {
  PUBLIC
  PRIVATE
}

model Media {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId           String                @map("vendor_id") @db.Uuid
  albumId            String?               @map("album_id") @db.Uuid
  mediaType          MediaType             @map("media_type")
  storageProvider    String                @default("cloudflare_r2") @map("storage_provider")
  originalObjectKey  String                @map("original_object_key")
  optimizedObjectKey String?               @map("optimized_object_key")
  thumbnailObjectKey String?               @map("thumbnail_object_key")
  mimeType           String                @map("mime_type")
  fileSize           Int                   @map("file_size")
  width              Int?
  height             Int?
  duration           Int?
  checksum           String?
  altText            String?               @map("alt_text")
  status             MediaStatus           @default(PENDING)
  moderationStatus   MediaModerationStatus @default(PENDING) @map("moderation_status")
  sortOrder          Int                   @default(0) @map("sort_order")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  vendor              Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  album               Album?          @relation("AlbumMedia", fields: [albumId], references: [id], onDelete: SetNull)
  userProfiles        UserProfile[]   @relation("UserProfileAvatar")
  vendorProfileLogos  VendorProfile[] @relation("VendorProfileLogo")
  vendorProfileCovers VendorProfile[] @relation("VendorProfileCover")
  albumCoverFor       Album[]         @relation("AlbumCover")

  @@index([vendorId])
  @@index([albumId])
  @@index([status])
  @@map("media")
}

model Album {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId     String          @map("vendor_id") @db.Uuid
  name         String
  description  String?
  coverMediaId String?         @map("cover_media_id") @db.Uuid
  visibility   AlbumVisibility @default(PUBLIC)
  sortOrder    Int             @default(0) @map("sort_order")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  vendor     Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  coverMedia Media?  @relation("AlbumCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  media      Media[] @relation("AlbumMedia")

  @@index([vendorId])
  @@map("albums")
}

model SearchLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  keyword      String?
  categoryId   String?  @map("category_id") @db.Uuid
  cityId       String?  @map("city_id") @db.Uuid
  filters      Json?
  sort         String?
  resultCount  Int      @map("result_count")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([keyword])
  @@map("search_logs")
}

// Favorites and named shortlists are unified into one model (product.md §15
// describes them as the same mechanism — named collections a vendor can
// belong to multiple of, e.g. "Photographers", "Final shortlist"). Every
// user gets exactly one auto-created isDefault shortlist ("Favorites") they
// cannot rename or delete; additional named shortlists are optional.
model Shortlist {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  name           String
  isDefault      Boolean   @default(false) @map("is_default")
  shareToken     String?   @unique @map("share_token")
  shareEnabled   Boolean   @default(false) @map("share_enabled")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ShortlistItem[]

  @@index([userId])
  @@map("shortlists")
}

model ShortlistItem {
  shortlistId String   @map("shortlist_id") @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  shortlist Shortlist @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([shortlistId, vendorId])
  @@index([vendorId])
  @@map("shortlist_items")
}

// A minimal, generic event log for Arch Phase 8's "analytics events" task
// (favorite/shortlist/compare actions). Deliberately narrow in scope — a
// full analytics pipeline (aggregation, dashboards, funnels) is Arch Phase
// 18's job; this only records that _something_ happened, the same
// best-effort, never-blocks-the-response pattern as Arch Phase 7's
// search_logs.
model AnalyticsEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  eventType String   @map("event_type")
  vendorId  String?  @map("vendor_id") @db.Uuid
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([vendorId])
  @@map("analytics_events")
}

enum EnquiryRoutingMode {
  SINGLE_VENDOR
  MULTI_VENDOR
  CATEGORY_REQUEST
}

enum LeadSource {
  WEB
  TELEGRAM
  ADMIN
  FUTURE_WHATSAPP
}

enum PreferredContactMethod {
  EMAIL
  PHONE
  WHATSAPP
}

// Platform-level record of what the user asked for (product.md §17/§19).
// Deliberately separate from Lead: one enquiry can fan out into several
// leads (MULTI_VENDOR routing), and enquiry-level fields never change once
// submitted — they describe the user's original request, not any one
// vendor's handling of it. product.md §20 is explicit that "vendor lead
// status is not necessarily the same as platform enquiry status," which is
// exactly why these are two models, not one with a vendorId column.
model Enquiry {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String?                 @map("user_id") @db.Uuid
  routingMode            EnquiryRoutingMode      @map("routing_mode")
  source                 LeadSource              @default(WEB)
  categoryId             String?                 @map("category_id") @db.Uuid
  cityId                 String?                 @map("city_id") @db.Uuid
  serviceId              String?                 @map("service_id") @db.Uuid
  contactName            String                  @map("contact_name")
  contactEmail           String                  @map("contact_email")
  contactPhone           String?                 @map("contact_phone")
  preferredContactMethod PreferredContactMethod? @map("preferred_contact_method")
  weddingDate            DateTime?               @map("wedding_date") @db.Date
  weddingLocation        String?                 @map("wedding_location")
  budget                 Decimal?                @db.Decimal(12, 2)
  guestCount             Int?                    @map("guest_count")
  message                String?
  createdAt              DateTime                @default(now()) @map("created_at")

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  city     Location? @relation(fields: [cityId], references: [id], onDelete: SetNull)
  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  leads    Lead[]

  @@index([userId])
  @@index([createdAt])
  @@map("enquiries")
}

enum LeadStatus {
  NEW
  CONTACTED
  RESPONDED
  QUALIFIED
  MEETING
  QUOTED
  WON
  LOST
  SPAM
  CLOSED
}

// The vendor-facing unit of work. A Lead's own status lifecycle (product.md
// §20) is independent of its parent Enquiry, which never changes state.
model Lead {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enquiryId    String     @map("enquiry_id") @db.Uuid
  vendorId     String     @map("vendor_id") @db.Uuid
  status       LeadStatus @default(NEW)
  contactedAt  DateTime?  @map("contacted_at")
  respondedAt  DateTime?  @map("responded_at")
  isSpam       Boolean    @default(false) @map("is_spam")
  dedupeKey    String     @map("dedupe_key")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  enquiry       Enquiry             @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  vendor        Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  statusHistory LeadStatusHistory[]
  notes         LeadNote[]

  @@index([vendorId, status])
  @@index([vendorId, createdAt])
  @@index([enquiryId])
  @@index([dedupeKey])
  @@map("leads")
}

model LeadStatusHistory {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId          String     @map("lead_id") @db.Uuid
  fromStatus      LeadStatus? @map("from_status")
  toStatus        LeadStatus @map("to_status")
  changedByUserId String?    @map("changed_by_user_id") @db.Uuid
  reason          String?
  createdAt       DateTime   @default(now()) @map("created_at")

  lead      Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@map("lead_status_history")
}

model LeadNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_notes")
}
