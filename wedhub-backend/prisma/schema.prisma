generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

enum UserRole {
  END_USER
  VENDOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String     @unique
  phone               String?    @unique
  passwordHash        String     @map("password_hash")
  role                UserRole   @default(END_USER)
  status              UserStatus @default(ACTIVE)
  emailVerifiedAt     DateTime?  @map("email_verified_at")
  phoneVerifiedAt     DateTime?  @map("phone_verified_at")
  lastLoginAt         DateTime?  @map("last_login_at")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  profile                  UserProfile?
  weddingProfile           WeddingProfile?
  adminUser                AdminUser?
  auditLogs                AuditLog[]
  refreshTokens            RefreshToken[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  vendor                   Vendor?
  vendorInvitationsSent    VendorInvitation[]       @relation("VendorInvitationsSent")
  vendorInvitationsClaimed VendorInvitation[]       @relation("VendorInvitationsClaimed")
  vendorStatusChanges      VendorStatusHistory[]
  searchLogs               SearchLog[]
  shortlists               Shortlist[]
  analyticsEvents          AnalyticsEvent[]
  enquiries                Enquiry[]
  leadStatusChanges        LeadStatusHistory[]
  leadNotes                LeadNote[]
  reviews                  Review[]
  reviewReports            ReviewReport[]
  featuredListingsCreated  FeaturedListing[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  telegramUser             TelegramUser?
  uploadedMedia            Media[]                  @relation("MediaUploader")
  weddingWebsites          WeddingWebsite[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model UserProfile {
  userId        String   @id @map("user_id") @db.Uuid
  firstName     String?  @map("first_name")
  lastName      String?  @map("last_name")
  avatarUrl     String?  @map("avatar_url")
  avatarMediaId String?  @map("avatar_media_id") @db.Uuid
  cityId        String?  @map("city_id") @db.Uuid
  bio           String?
  preferences   Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarMedia Media? @relation("UserProfileAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)

  @@map("user_profiles")
}

model WeddingProfile {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  weddingDate     DateTime? @map("wedding_date")
  cityId          String?   @map("city_id") @db.Uuid
  venueCityId     String?   @map("venue_city_id") @db.Uuid
  guestCount      Int?      @map("guest_count")
  estimatedBudget Decimal?  @map("estimated_budget") @db.Decimal(12, 2)
  weddingStyle    String?   @map("wedding_style")
  partnerName     String?   @map("partner_name")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wedding_profiles")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  adminUsers      AdminUser[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AdminUser {
  userId    String   @id @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@map("admin_users")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum AttributeDataType {
  BOOLEAN
  NUMBER
  TEXT
  SELECT
  MULTI_SELECT
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  parentId    String?  @map("parent_id") @db.Uuid
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Homepage presentation fields — admin-controlled, presentation-only
  // (not used by search/matching logic). Added to back the public
  // homepage's category carousel/bento grid with real, admin-editable
  // data instead of a hardcoded frontend array.
  imageUrl             String? @map("image_url")
  isFeaturedOnHomepage Boolean @default(false) @map("is_featured_on_homepage")
  homepageSortOrder    Int     @default(0) @map("homepage_sort_order")
  startingPriceLabel   String? @map("starting_price_label")

  parent           Category?           @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Category[]          @relation("CategoryHierarchy")
  attributes       CategoryAttribute[]
  services         Service[]
  vendorCategories VendorCategory[]
  enquiries        Enquiry[]
  featuredListings FeaturedListing[]
  seoOverrides     SeoOverride[]

  @@index([parentId])
  @@index([isActive])
  @@index([isFeaturedOnHomepage])
  @@map("categories")
}

model CategoryAttribute {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId   String            @map("category_id") @db.Uuid
  key          String
  label        String
  dataType     AttributeDataType @map("data_type")
  options      Json?
  isFilterable Boolean           @default(false) @map("is_filterable")
  isComparable Boolean           @default(false) @map("is_comparable")
  sortOrder    Int               @default(0) @map("sort_order")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  vendorAttributeValues VendorAttributeValue[]

  @@unique([categoryId, key])
  @@map("category_attributes")
}

enum LocationType {
  COUNTRY
  STATE
  CITY
  AREA
}

model Location {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      LocationType
  name      String
  slug      String
  parentId  String?      @map("parent_id") @db.Uuid
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  parent                 Location?           @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children               Location[]          @relation("LocationHierarchy")
  vendorsWithPrimaryCity Vendor[]            @relation("VendorPrimaryCity")
  vendorServiceAreas     VendorServiceArea[]
  enquiries              Enquiry[]
  featuredListings       FeaturedListing[]
  seoOverrides           SeoOverride[]

  @@unique([parentId, slug])
  @@index([type])
  @@index([parentId])
  @@map("locations")
}

enum VendorStatus {
  DRAFT
  PENDING_VERIFICATION
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
  DEACTIVATED
}

enum VerificationLevel {
  UNVERIFIED
  IDENTITY_VERIFIED
  BUSINESS_VERIFIED
  PLATFORM_VERIFIED
}

enum VendorCreationSource {
  SELF_REGISTERED
  ADMIN_CREATED
}

model Vendor {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId         String?              @unique @map("owner_user_id") @db.Uuid
  businessName        String               @map("business_name")
  slug                String               @unique
  status              VendorStatus         @default(DRAFT)
  creationSource      VendorCreationSource @map("creation_source")
  verificationLevel   VerificationLevel    @default(UNVERIFIED) @map("verification_level")
  cityId              String?              @map("city_id") @db.Uuid
  rejectionReason     String?              @map("rejection_reason")
  suspensionReason    String?              @map("suspension_reason")
  approvedAt          DateTime?            @map("approved_at")
  submittedAt         DateTime?            @map("submitted_at")
  profileCompleteness Int                  @default(0) @map("profile_completeness")
  averageRating       Decimal              @default(0) @map("average_rating") @db.Decimal(3, 2)
  reviewCount         Int                  @default(0) @map("review_count")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")

  owner            User?                  @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  city             Location?              @relation("VendorPrimaryCity", fields: [cityId], references: [id], onDelete: SetNull)
  profile          VendorProfile?
  categories       VendorCategory[]
  serviceAreas     VendorServiceArea[]
  attributeValues  VendorAttributeValue[]
  services         VendorService[]
  packages         Package[]
  invitations      VendorInvitation[]
  statusHistory    VendorStatusHistory[]
  media            Media[]
  albums           Album[]
  shortlistItems   ShortlistItem[]
  leads            Lead[]
  reviews          Review[]
  subscriptions    Subscription[]
  pendingPayments  Payment[]
  featuredListings FeaturedListing[]
  billingProfile   VendorBillingProfile?
  vendorInvoices   VendorInvoice[]

  @@index([status])
  @@index([cityId])
  @@index([ownerUserId])
  @@index([status, cityId])
  // GIN trigram index for pg_trgm fuzzy keyword search (Arch Phase 7). Needs
  // the postgresqlExtensions preview feature (see generator/datasource
  // blocks above) since `ops: gin_trgm_ops` isn't expressible otherwise —
  // first attempted as untracked raw SQL, which a later migration's drift
  // detection silently dropped, so this is now first-class schema state.
  @@index([businessName(ops: raw("gin_trgm_ops"))], type: Gin, name: "vendors_business_name_trgm_idx")
  @@map("vendors")
}

model VendorProfile {
  vendorId             String   @id @map("vendor_id") @db.Uuid
  shortDescription     String?  @map("short_description")
  description          String?
  logoMediaId          String?  @map("logo_media_id") @db.Uuid
  coverMediaId         String?  @map("cover_media_id") @db.Uuid
  vendorType           String?  @map("vendor_type")
  tags                 String[] @default([])
  address              String?
  latitude             Decimal? @db.Decimal(9, 6)
  longitude            Decimal? @db.Decimal(9, 6)
  startingPrice        Decimal? @map("starting_price") @db.Decimal(12, 2)
  priceRangeMin        Decimal? @map("price_range_min") @db.Decimal(12, 2)
  priceRangeMax        Decimal? @map("price_range_max") @db.Decimal(12, 2)
  currency             String   @default("INR")
  customQuoteAvailable Boolean  @default(false) @map("custom_quote_available")
  yearsExperience      Int?     @map("years_experience")
  teamSize             Int?     @map("team_size")
  languages            String[] @default([])
  travelPolicy         String?  @map("travel_policy")
  website              String?
  phone                String?
  email                String?
  socialLinks          Json?    @map("social_links")
  businessHours        Json?    @map("business_hours")
  availabilityNotes    String?  @map("availability_notes")
  seoTitle             String?  @map("seo_title")
  seoDescription       String?  @map("seo_description")
  canonicalUrl         String?  @map("canonical_url")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  vendor     Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  logoMedia  Media? @relation("VendorProfileLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  coverMedia Media? @relation("VendorProfileCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  @@index([startingPrice])
  // GIN trigram indexes power Arch Phase 7's fuzzy keyword search across
  // vendor descriptions. The tags[] index uses the default array GIN ops
  // (containment/overlap, e.g. `tags && ARRAY[...]`), not gin_trgm_ops —
  // trigram ops are for text similarity, not array membership.
  @@index([shortDescription(ops: raw("gin_trgm_ops"))], type: Gin, name: "vendor_profiles_short_description_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, name: "vendor_profiles_description_trgm_idx")
  @@index([tags], type: Gin, name: "vendor_profiles_tags_gin_idx")
  @@map("vendor_profiles")
}

model VendorCategory {
  vendorId   String   @map("vendor_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([vendorId, categoryId])
  @@index([categoryId])
  @@map("vendor_categories")
}

model VendorServiceArea {
  vendorId   String   @map("vendor_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([vendorId, locationId])
  @@index([locationId])
  @@map("vendor_service_areas")
}

model VendorAttributeValue {
  vendorId     String   @map("vendor_id") @db.Uuid
  attributeId  String   @map("attribute_id") @db.Uuid
  valueText    String?  @map("value_text")
  valueNumber  Decimal? @map("value_number") @db.Decimal(14, 4)
  valueBoolean Boolean? @map("value_boolean")
  valueOptions String[] @default([]) @map("value_options")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  vendor    Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  attribute CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([vendorId, attributeId])
  @@map("vendor_attribute_values")
}

model Service {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String
  slug        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  vendorServices VendorService[]
  enquiries      Enquiry[]
  reviews        Review[]

  @@unique([categoryId, slug])
  @@map("services")
}

model VendorService {
  vendorId  String   @map("vendor_id") @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([vendorId, serviceId])
  @@index([serviceId])
  @@map("vendor_services")
}

model Package {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("INR")
  inclusions  String[] @default([])
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("packages")
}

model VendorInvitation {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId         String    @map("vendor_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash")
  invitedEmail     String?   @map("invited_email")
  invitedByAdminId String    @map("invited_by_admin_id") @db.Uuid
  expiresAt        DateTime  @map("expires_at")
  usedAt           DateTime? @map("used_at")
  claimedByUserId  String?   @map("claimed_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")

  vendor         Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  invitedByAdmin User   @relation("VendorInvitationsSent", fields: [invitedByAdminId], references: [id], onDelete: Restrict)
  claimedByUser  User?  @relation("VendorInvitationsClaimed", fields: [claimedByUserId], references: [id], onDelete: SetNull)

  @@index([vendorId])
  @@map("vendor_invitations")
}

model VendorStatusHistory {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId        String        @map("vendor_id") @db.Uuid
  fromStatus      VendorStatus? @map("from_status")
  toStatus        VendorStatus  @map("to_status")
  reason          String?
  changedByUserId String?       @map("changed_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")

  vendor    Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  changedBy User?  @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([vendorId])
  @@map("vendor_status_history")
}

enum MediaType {
  LOGO
  COVER
  PORTFOLIO
  VIDEO
  REVIEW_PHOTO
  // Admin-only, platform-owned image (no vendorId/userId) — e.g. the
  // homepage category carousel's Category.imageUrl. Added 2026-09-03.
  CATEGORY_IMAGE
  // Arch Phase 26 — owned by weddingWebsiteId, not vendorId, following the
  // exact same nullable-owner-column precedent REVIEW_PHOTO established
  // (a WeddingWebsite owner may have no Vendor at all — see
  // docs/12-stage-wedding-website.md's "Photo ownership" decision).
  WEDDING_WEBSITE_PHOTO
  // Admin-only, platform-owned image (no vendorId/userId) — backs
  // PopularSearchCard.imageUrl, same shape as CATEGORY_IMAGE above but
  // kept as its own value (not reused) so admin-media's per-mediaType
  // confirm checks stay unambiguous about which curated content owns the
  // upload. Added 2026-09-04, same day as WeddingStory/FeaturedMedia.
  POPULAR_SEARCH_IMAGE
  // Admin-only, platform-owned image (no vendorId/userId) — backs
  // BlogPost.coverImageUrl, same shape as CATEGORY_IMAGE/POPULAR_SEARCH_IMAGE
  // above but kept as its own value (not reused) so admin-media's per-
  // mediaType confirm checks stay unambiguous about which curated content
  // owns the upload. Added 2026-09-04, closing out Arch Phase 17 (CMS &
  // SEO Backend)'s last remaining item.
  BLOG_COVER_IMAGE
}

enum MediaStatus {
  PENDING
  UPLOADING
  PROCESSING
  READY
  INACTIVE
  FAILED
  DELETED
}

enum MediaModerationStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum AlbumVisibility {
  PUBLIC
  PRIVATE
}

model Media {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Nullable: a REVIEW_PHOTO is owned by the reviewing user (userId +
  // reviewId), not a vendor — every other mediaType still requires vendorId,
  // enforced at the application layer (media.service.ts /
  // review-media.service.ts), not the DB, since Prisma has no portable
  // conditional-required-column constraint.
  vendorId           String?               @map("vendor_id") @db.Uuid
  userId             String?               @map("user_id") @db.Uuid
  reviewId           String?               @map("review_id") @db.Uuid
  albumId            String?               @map("album_id") @db.Uuid
  weddingWebsiteId   String?               @map("wedding_website_id") @db.Uuid
  mediaType          MediaType             @map("media_type")
  storageProvider    String                @default("cloudflare_r2") @map("storage_provider")
  originalObjectKey  String                @map("original_object_key")
  optimizedObjectKey String?               @map("optimized_object_key")
  thumbnailObjectKey String?               @map("thumbnail_object_key")
  mimeType           String                @map("mime_type")
  fileSize           Int                   @map("file_size")
  width              Int?
  height             Int?
  duration           Int?
  checksum           String?
  altText            String?               @map("alt_text")
  status             MediaStatus           @default(PENDING)
  moderationStatus   MediaModerationStatus @default(PENDING) @map("moderation_status")
  sortOrder          Int                   @default(0) @map("sort_order")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  vendor                       Vendor?         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  uploader                     User?           @relation("MediaUploader", fields: [userId], references: [id], onDelete: Cascade)
  review                       Review?         @relation("ReviewPhotos", fields: [reviewId], references: [id], onDelete: Cascade)
  album                        Album?          @relation("AlbumMedia", fields: [albumId], references: [id], onDelete: SetNull)
  weddingWebsite               WeddingWebsite? @relation("WeddingWebsiteGallery", fields: [weddingWebsiteId], references: [id], onDelete: Cascade)
  userProfiles                 UserProfile[]   @relation("UserProfileAvatar")
  vendorProfileLogos           VendorProfile[] @relation("VendorProfileLogo")
  vendorProfileCovers          VendorProfile[] @relation("VendorProfileCover")
  albumCoverFor                Album[]         @relation("AlbumCover")
  featuredMedia                FeaturedMedia?
  weddingWebsiteCoverFor       WeddingWebsite? @relation("WeddingWebsiteCover")
  weddingWebsiteCouplePhotoFor WeddingWebsite? @relation("WeddingWebsiteCouplePhoto")

  @@index([vendorId])
  @@index([userId])
  @@index([reviewId])
  @@index([albumId])
  @@index([weddingWebsiteId])
  @@index([status])
  @@map("media")
}

model Album {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId     String          @map("vendor_id") @db.Uuid
  name         String
  description  String?
  coverMediaId String?         @map("cover_media_id") @db.Uuid
  visibility   AlbumVisibility @default(PUBLIC)
  sortOrder    Int             @default(0) @map("sort_order")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  vendor         Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  coverMedia     Media?         @relation("AlbumCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  media          Media[]        @relation("AlbumMedia")
  weddingStories WeddingStory[]

  @@index([vendorId])
  @@map("albums")
}

// Arch Phase 17 (CMS & SEO Backend) — backs the public homepage's "Real
// Wedding Stories" section, previously a hardcoded static array
// (wedhub-frontend-app/app/(public)/page.tsx's REAL_WEDDING_STORIES).
// Deliberately thin: references a real Album (already belongs to a real
// Vendor, already has real photos) rather than duplicating an image
// upload path — this model only carries the narrative fields an Album
// doesn't have. No fabricated couples/photos; an admin picks a real,
// already-public wedding photo album and adds the story copy around it.
model WeddingStory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  albumId    String   @map("album_id") @db.Uuid
  coupleName String   @map("couple_name")
  location   String
  tag        String
  snippet    String
  isFeatured Boolean  @default(false) @map("is_featured")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([isFeatured])
  @@map("wedding_stories")
}

// Arch Phase 17 — backs the public homepage's "Gallery Inspiration"
// section (GalleryInspiration.tsx's hardcoded GALLERY_ITEMS). An admin
// curates specific, already-real, already-public vendor Media rows for
// homepage display — no new image upload path, no fabricated photos.
model FeaturedMedia {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaId       String   @unique @map("media_id") @db.Uuid
  titleOverride String?  @map("title_override")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@map("featured_media")
}

enum SeoPageType {
  CATEGORY
  CITY
  CATEGORY_CITY
}

// Arch Phase 17 — backs the public homepage's "Popular Searches" section
// (page.tsx's hardcoded POPULAR_SEARCH_CARDS). Unlike WeddingStory/
// FeaturedMedia, there is no existing real entity to curate over here — a
// "popular search" is a title + location blurb + indicative price + a
// search link, none of which map onto any real Vendor/Category/Location
// row. So this is a genuinely standalone, fully admin-curated (editorial,
// not analytics-driven — Arch Phase 18 analytics doesn't exist yet) model
// with its own image, following the exact Category.imageUrl precedent
// (plain nullable String url, resolved through the CATEGORY_IMAGE admin
// upload pipeline) rather than a Media-reference (there's no owning
// vendor for this image to attach to, same reasoning as Category's).
model PopularSearchCard {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  locationBlurb String   @map("location_blurb")
  priceLabel    String   @map("price_label")
  imageUrl      String?  @map("image_url")
  searchQuery   String   @map("search_query")
  isFeatured    Boolean  @default(false) @map("is_featured")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isFeatured])
  @@map("popular_search_cards")
}

// Arch Phase 17 — the last remaining CMS & SEO Backend item: a real Blog/
// article content model, replacing the homepage's hardcoded LATEST_BLOGS
// array and backing new public /blog list + /blog/:slug detail pages.
// Body content is authored as Markdown (bodyMarkdown, rendered client-side
// via react-markdown) and stored as plain text — no rich-text/HTML
// sanitization pipeline exists yet, so this deliberately stays as simple
// as PopularSearchCard rather than introducing a new content-authoring
// subsystem. category is a plain free-text tag (e.g. "Bridal Fashion"),
// not a relation to the vendor-facing Category model — a blog category
// tag is editorial copy, not a taxonomy node vendors attach to. coverImageUrl
// follows the exact PopularSearchCard.imageUrl precedent (plain nullable
// String url via the BLOG_COVER_IMAGE admin upload pipeline, no Media
// relation — there's no owning vendor for this image to attach to).
// publishedAt does double duty as the draft/published flag (null = draft,
// set = published) rather than a separate status enum, matching how
// isFeatured elsewhere is a plain toggle with no dedicated "feature"
// endpoint — publishing here is just PATCH-setting publishedAt. seoTitle/
// seoDescription mirror VendorProfile's override-over-a-default fields,
// falling back to title/excerpt when unset.
model BlogPost {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  slug            String    @unique
  category        String
  coverImageUrl   String?   @map("cover_image_url")
  excerpt         String
  bodyMarkdown    String    @map("body_markdown")
  readTimeMinutes Int       @map("read_time_minutes")
  publishedAt     DateTime? @map("published_at")
  isFeatured      Boolean   @default(false) @map("is_featured")
  sortOrder       Int       @default(0) @map("sort_order")
  seoTitle        String?   @map("seo_title")
  seoDescription  String?   @map("seo_description")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([isFeatured])
  @@index([publishedAt])
  @@map("blog_posts")
}

// Arch Phase 17 — SEO page-generation infrastructure. Category/City/
// Category+City landing pages (product.md §44) are generated from a
// template at request time (name interpolation + real vendor count from
// the existing /search/vendors query path), NOT hand-authored per
// combination — there can be hundreds of real combinations. This table
// only holds an optional admin override of the computed title/description/
// OG image for one specific combination, mirroring the existing
// VendorProfile.seoTitle/seoDescription override-over-a-default pattern.
// A row is looked up by (pageType, categoryId, locationId) — categoryId
// and/or locationId are null depending on pageType.
model SeoOverride {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageType    SeoPageType @map("page_type")
  categoryId  String?     @map("category_id") @db.Uuid
  locationId  String?     @map("location_id") @db.Uuid
  title       String?
  description String?
  ogImageUrl  String?     @map("og_image_url")
  noIndex     Boolean     @default(false) @map("no_index")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([pageType, categoryId, locationId])
  @@map("seo_overrides")
}

model SearchLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  keyword     String?
  categoryId  String?  @map("category_id") @db.Uuid
  cityId      String?  @map("city_id") @db.Uuid
  filters     Json?
  sort        String?
  resultCount Int      @map("result_count")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([keyword])
  @@map("search_logs")
}

// Favorites and named shortlists are unified into one model (product.md §15
// describes them as the same mechanism — named collections a vendor can
// belong to multiple of, e.g. "Photographers", "Final shortlist"). Every
// user gets exactly one auto-created isDefault shortlist ("Favorites") they
// cannot rename or delete; additional named shortlists are optional.
model Shortlist {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String
  isDefault    Boolean  @default(false) @map("is_default")
  shareToken   String?  @unique @map("share_token")
  shareEnabled Boolean  @default(false) @map("share_enabled")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ShortlistItem[]

  @@index([userId])
  @@map("shortlists")
}

model ShortlistItem {
  shortlistId String   @map("shortlist_id") @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  shortlist Shortlist @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([shortlistId, vendorId])
  @@index([vendorId])
  @@map("shortlist_items")
}

// A minimal, generic event log for Arch Phase 8's "analytics events" task
// (favorite/shortlist/compare actions). Deliberately narrow in scope — a
// full analytics pipeline (aggregation, dashboards, funnels) is Arch Phase
// 18's job; this only records that _something_ happened, the same
// best-effort, never-blocks-the-response pattern as Arch Phase 7's
// search_logs.
model AnalyticsEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  eventType String   @map("event_type")
  vendorId  String?  @map("vendor_id") @db.Uuid
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([vendorId])
  @@map("analytics_events")
}

enum EnquiryRoutingMode {
  SINGLE_VENDOR
  MULTI_VENDOR
  CATEGORY_REQUEST
}

enum LeadSource {
  WEB
  TELEGRAM
  ADMIN
  FUTURE_WHATSAPP
}

enum PreferredContactMethod {
  EMAIL
  PHONE
  WHATSAPP
}

// Platform-level record of what the user asked for (product.md §17/§19).
// Deliberately separate from Lead: one enquiry can fan out into several
// leads (MULTI_VENDOR routing), and enquiry-level fields never change once
// submitted — they describe the user's original request, not any one
// vendor's handling of it. product.md §20 is explicit that "vendor lead
// status is not necessarily the same as platform enquiry status," which is
// exactly why these are two models, not one with a vendorId column.
model Enquiry {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String?                 @map("user_id") @db.Uuid
  routingMode            EnquiryRoutingMode      @map("routing_mode")
  source                 LeadSource              @default(WEB)
  categoryId             String?                 @map("category_id") @db.Uuid
  cityId                 String?                 @map("city_id") @db.Uuid
  serviceId              String?                 @map("service_id") @db.Uuid
  contactName            String                  @map("contact_name")
  contactEmail           String                  @map("contact_email")
  contactPhone           String?                 @map("contact_phone")
  preferredContactMethod PreferredContactMethod? @map("preferred_contact_method")
  weddingDate            DateTime?               @map("wedding_date") @db.Date
  weddingLocation        String?                 @map("wedding_location")
  budget                 Decimal?                @db.Decimal(12, 2)
  guestCount             Int?                    @map("guest_count")
  message                String?
  createdAt              DateTime                @default(now()) @map("created_at")

  user                  User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  category              Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  city                  Location?              @relation(fields: [cityId], references: [id], onDelete: SetNull)
  service               Service?               @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  leads                 Lead[]
  telegramConversations TelegramConversation[]

  @@index([userId])
  @@index([createdAt])
  @@map("enquiries")
}

enum LeadStatus {
  NEW
  CONTACTED
  RESPONDED
  QUALIFIED
  MEETING
  QUOTED
  WON
  LOST
  SPAM
  CLOSED
}

// The vendor-facing unit of work. A Lead's own status lifecycle (product.md
// §20) is independent of its parent Enquiry, which never changes state.
model Lead {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enquiryId   String     @map("enquiry_id") @db.Uuid
  vendorId    String     @map("vendor_id") @db.Uuid
  status      LeadStatus @default(NEW)
  contactedAt DateTime?  @map("contacted_at")
  respondedAt DateTime?  @map("responded_at")
  isSpam      Boolean    @default(false) @map("is_spam")
  dedupeKey   String     @map("dedupe_key")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  enquiry       Enquiry             @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  vendor        Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  statusHistory LeadStatusHistory[]
  notes          LeadNote[]
  vendorInvoices VendorInvoice[]

  @@index([vendorId, status])
  @@index([vendorId, createdAt])
  @@index([enquiryId])
  @@index([dedupeKey])
  @@map("leads")
}

model LeadStatusHistory {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId          String      @map("lead_id") @db.Uuid
  fromStatus      LeadStatus? @map("from_status")
  toStatus        LeadStatus  @map("to_status")
  changedByUserId String?     @map("changed_by_user_id") @db.Uuid
  reason          String?
  createdAt       DateTime    @default(now()) @map("created_at")

  lead      Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@map("lead_status_history")
}

model LeadNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_notes")
}

// Arch Phase 10. Status set matches architecture.md's own concrete schema
// section (PENDING/APPROVED/REJECTED/FLAGGED/HIDDEN) rather than product.md's
// looser prose list of admin actions (approve/hide/remove/investigate/mark
// disputed) — used as authoritative per the stage file's own note, since one
// is a real enum and the other is a description of intent.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
  HIDDEN
}

// One review per (user, vendor) — enforced by the compound unique constraint
// below — regardless of how many leads/enquiries exist between them.
// verifiedInteraction is true when the reviewing user has at least one Lead
// against this vendor at the time of submission (any status); confirmed with
// the user as the "legitimate interaction" signal now that Arch Phase 9
// exists, rather than requiring a WON outcome specifically.
model Review {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String       @map("user_id") @db.Uuid
  vendorId            String       @map("vendor_id") @db.Uuid
  serviceId           String?      @map("service_id") @db.Uuid
  rating              Int
  title               String?
  content             String?
  eventDate           DateTime?    @map("event_date") @db.Date
  verifiedInteraction Boolean      @default(false) @map("verified_interaction")
  status              ReviewStatus @default(PENDING)
  vendorResponse      String?      @map("vendor_response")
  vendorRespondedAt   DateTime?    @map("vendor_responded_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor  Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  service Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  reports ReviewReport[]
  photos  Media[]        @relation("ReviewPhotos")

  @@unique([userId, vendorId])
  @@index([vendorId, status])
  @@index([status])
  @@map("reviews")
}

model ReviewReport {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId   String   @map("review_id") @db.Uuid
  reporterId String   @map("reporter_id") @db.Uuid
  reason     String
  createdAt  DateTime @default(now()) @map("created_at")

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reviewId, reporterId])
  @@index([reviewId])
  @@map("review_reports")
}

enum PlanTier {
  FREE
  PRO
  PREMIUM
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

// Admin-configurable pricing (product.md §26: "Never hardcode plan prices").
// One row per tier×interval combination (e.g. PRO/MONTHLY and PRO/YEARLY are
// two separate rows) since yearly pricing is not simply monthly×12 in
// practice (annual discounts). `features`/`limits` are JSONB rather than
// typed columns — unlike CategoryAttribute's typed-value precedent, plan
// features are read by application code as a whole bundle (EntitlementService
// in Arch Phase 12), not queried/filtered column-by-column the way vendor
// attributes are, so a flexible blob is the right tool here.
model SubscriptionPlan {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tier            PlanTier
  billingInterval BillingInterval @map("billing_interval")
  name            String
  price           Decimal         @db.Decimal(10, 2)
  currency        String          @default("INR")
  trialDays       Int             @default(0) @map("trial_days")
  features        Json            @default("{}")
  limits          Json            @default("{}")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  subscriptions   Subscription[]
  pendingPayments Payment[]

  @@unique([tier, billingInterval])
  @@map("subscription_plans")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

// One Subscription row per vendor billing lifecycle "episode" — a vendor who
// cancels and later resubscribes gets a new row, not a reused one, so the
// full history (including past cancelled/expired subscriptions) is never
// destroyed. "What plan is this vendor on right now" is deliberately NOT a
// denormalized column on Vendor — confirmed with the user — it's derived by
// querying this table for the vendor's latest TRIALING/ACTIVE/PAST_DUE row,
// falling back to an implicit FREE plan if none exists. This avoids a second
// place that must be kept in sync with status transitions.
model Subscription {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId               String             @map("vendor_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  status                 SubscriptionStatus @default(TRIALING)
  razorpaySubscriptionId String?            @unique @map("razorpay_subscription_id")
  currentPeriodStart     DateTime           @map("current_period_start")
  currentPeriodEnd       DateTime           @map("current_period_end")
  trialEndsAt            DateTime?          @map("trial_ends_at")
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  cancelledAt            DateTime?          @map("cancelled_at")
  pastDueSince           DateTime?          @map("past_due_since")
  couponId               String?            @map("coupon_id") @db.Uuid
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  vendor   Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  coupon   Coupon?          @relation(fields: [couponId], references: [id], onDelete: SetNull)
  payments Payment[]
  invoices Invoice[]

  @@index([vendorId, status])
  @@index([status])
  @@map("subscriptions")
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

// Arch Phase 26 — discriminates what a Payment is actually for. Default
// SUBSCRIPTION keeps every pre-existing row (and every subscription-flow
// code path) unaffected. WEDDING_WEBSITE payments never populate
// pendingVendorId/pendingPlanId/pendingCouponId (those are subscription-
// checkout-specific) — they populate weddingWebsiteId instead. See
// docs/12-stage-wedding-website.md's "Payment model fit" decision: reuse
// this table via a discriminator rather than a parallel one-time-payment
// table, since WebhookEvent idempotency and order-creation are already
// provider/purpose-agnostic.
enum PaymentPurpose {
  SUBSCRIPTION
  WEDDING_WEBSITE
}

// A Payment can exist BEFORE any Subscription does — per product.md §28
// Scenario B/C, a subscription only becomes ACTIVE once the webhook
// confirms payment, so the checkout-initiation step (creating the Razorpay
// order) cannot create an ACTIVE Subscription up front. Instead the pending
// checkout's vendor/plan/coupon selection is stored directly on the Payment
// row; the webhook handler creates the real Subscription (status ACTIVE)
// only once payment.captured actually arrives, then backfills
// subscriptionId. subscriptionId is nullable specifically for this
// pending-checkout window.
model Payment {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purpose               PaymentPurpose @default(SUBSCRIPTION)
  subscriptionId        String?        @map("subscription_id") @db.Uuid
  pendingVendorId       String?        @map("pending_vendor_id") @db.Uuid
  pendingPlanId         String?        @map("pending_plan_id") @db.Uuid
  pendingCouponId       String?        @map("pending_coupon_id") @db.Uuid
  weddingWebsiteId      String?        @map("wedding_website_id") @db.Uuid
  provider              String         @default("razorpay")
  razorpayOrderId       String?        @unique @map("razorpay_order_id")
  razorpayPaymentId     String?        @unique @map("razorpay_payment_id")
  // Set only for Telegram-originated wedding-website publish payments —
  // Razorpay's Payment Links API (not Orders+Checkout.js, since there's
  // no browser inside a Telegram chat) fires its own payment_link.paid
  // webhook event, correlated back to this row via the link's own id
  // (echoed in that event's payload.payment_link.entity.id), not via
  // razorpayOrderId — a Payment Link creates its own internal order that
  // was never generated or stored by us ahead of time, unlike the web
  // checkout flow's pre-created order. See docs/12-stage-wedding-website.md.
  razorpayPaymentLinkId String?        @unique @map("razorpay_payment_link_id")
  amount                Decimal        @db.Decimal(10, 2)
  currency              String         @default("INR")
  status                PaymentStatus  @default(CREATED)
  failureReason         String?        @map("failure_reason")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  subscription    Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  pendingVendor   Vendor?           @relation(fields: [pendingVendorId], references: [id], onDelete: Cascade)
  pendingPlan     SubscriptionPlan? @relation(fields: [pendingPlanId], references: [id], onDelete: Restrict)
  pendingCoupon   Coupon?           @relation(fields: [pendingCouponId], references: [id], onDelete: SetNull)
  weddingWebsite  WeddingWebsite?   @relation(fields: [weddingWebsiteId], references: [id], onDelete: Cascade)
  invoice         Invoice?
  refunds         Refund[]
  featuredListing FeaturedListing?

  @@index([subscriptionId])
  @@index([pendingVendorId])
  @@index([weddingWebsiteId])
  @@map("payments")
}

// Original payment rows are never mutated to reflect a refund (product.md
// §28 Scenario H: "original payment remains immutable") — a Refund is
// always a separate, additional record.
model Refund {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId        String   @map("payment_id") @db.Uuid
  razorpayRefundId String?  @unique @map("razorpay_refund_id")
  amount           Decimal  @db.Decimal(10, 2)
  reason           String?
  createdAt        DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("refunds")
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID
}

model Invoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String        @map("subscription_id") @db.Uuid
  paymentId      String?       @unique @map("payment_id") @db.Uuid
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("INR")
  status         InvoiceStatus @default(ISSUED)
  issuedAt       DateTime      @default(now()) @map("issued_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@map("invoices")
}

// Every inbound Razorpay webhook is logged here BEFORE processing, keyed on
// Razorpay's own event id — product.md §29's "signature verified, idempotent,
// logged, replay-safe" requirement. A second delivery of the same event id
// is detected via the unique constraint and safely ignored (Scenario D).
model WebhookEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String    @default("razorpay")
  eventId     String    @unique @map("event_id")
  eventType   String    @map("event_type")
  payload     Json
  processedAt DateTime? @map("processed_at")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([eventType])
  @@map("webhook_events")
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Coupon {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String             @unique
  discountType   CouponDiscountType @map("discount_type")
  discountValue  Decimal            @map("discount_value") @db.Decimal(10, 2)
  maxRedemptions Int?               @map("max_redemptions")
  timesRedeemed  Int                @default(0) @map("times_redeemed")
  validFrom      DateTime?          @map("valid_from")
  validUntil     DateTime?          @map("valid_until")
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at")

  subscriptions   Subscription[]
  pendingPayments Payment[]

  @@map("coupons")
}

// Arch Phase 13 (thin slice per 02-mvp-cut-line.md): data model + admin CRUD
// only. Automatic activation/expiry scheduling, vendor self-purchase, and
// actual homepage/search-result placement logic are all deferred — status
// is admin-set by hand for now, not flipped by any scheduler.
enum PlacementType {
  HOMEPAGE
  CATEGORY_PAGE
  CITY_PAGE
  SEARCH_RESULTS
}

enum FeaturedListingStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  EXPIRED
  CANCELLED
}

model FeaturedListing {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId        String                @map("vendor_id") @db.Uuid
  placementType   PlacementType         @map("placement_type")
  categoryId      String?               @map("category_id") @db.Uuid
  cityId          String?               @map("city_id") @db.Uuid
  priority        Int                   @default(0)
  price           Decimal               @db.Decimal(10, 2)
  currency        String                @default("INR")
  startDate       DateTime              @map("start_date")
  endDate         DateTime              @map("end_date")
  status          FeaturedListingStatus @default(DRAFT)
  paymentId       String?               @unique @map("payment_id") @db.Uuid
  createdByUserId String                @map("created_by_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  city      Location? @relation(fields: [cityId], references: [id], onDelete: SetNull)
  payment   Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdBy User      @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([vendorId])
  @@index([status, startDate, endDate])
  @@index([placementType, categoryId, cityId])
  @@map("featured_listings")
}

// Arch Phase 14: product.md §45's 12 notification events, superseding Arch
// Phase 9's narrower LeadNotificationEventType (NEW_LEAD/LEAD_REMINDER/
// USER_REPLIED/LEAD_FOLLOW_UP/HIGH_INTENT_LEAD are carried over unchanged
// below) — one generic notification system rather than a lead-specific one
// plus a separate general one, confirmed with the user. PASSWORD_RESET is
// one extra event beyond product.md's literal 12 — auth.service.ts already
// had a pre-existing stub expecting real email delivery for it.
enum NotificationEventType {
  REGISTRATION
  VERIFICATION
  PASSWORD_RESET
  VENDOR_APPROVED
  VENDOR_REJECTED
  NEW_LEAD
  LEAD_REMINDER
  USER_REPLIED
  LEAD_FOLLOW_UP
  HIGH_INTENT_LEAD
  NEW_MESSAGE
  REVIEW_RECEIVED
  SUBSCRIPTION_ACTIVATED
  PAYMENT_FAILED
  SUBSCRIPTION_EXPIRING
  FEATURED_CAMPAIGN_STARTED
  FEATURED_CAMPAIGN_ENDING
  // Added 2026-09-03 (docs/bugs.md #4) — none of the 17 events above are
  // couple-facing "your enquiry moved forward" updates (USER_REPLIED/
  // NEW_MESSAGE are written from the vendor's inbox perspective). Fires on
  // every lead status transition, vendor- or admin-driven, per user decision.
  LEAD_STATUS_UPDATED
}

// SMS/WhatsApp are explicitly "later" per product.md §22 — not modeled yet.
enum NotificationChannel {
  IN_APP
  EMAIL
  TELEGRAM
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

// One row per (recipient, event, channel) delivery — this is simultaneously
// the in-app notification record a user reads, the delivery/retry history,
// and (via status=FAILED with maxed-out attempts) the dead-letter record.
// No separate table for "notification history" — this table already is
// that history, matching Coding Rule 7 (external effects happen after DB
// commit, via a job) since the row is written before the queue job that
// actually delivers it runs.
model Notification {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  eventType         NotificationEventType @map("event_type")
  channel           NotificationChannel
  status            NotificationStatus    @default(PENDING)
  title             String
  body              String
  data              Json?
  relatedEntityType String?               @map("related_entity_type")
  relatedEntityId   String?               @map("related_entity_id")
  attempts          Int                   @default(0)
  lastError         String?               @map("last_error")
  sentAt            DateTime?             @map("sent_at")
  readAt            DateTime?             @map("read_at")
  createdAt         DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, readAt])
  @@index([eventType])
  @@index([relatedEntityType, relatedEntityId])
  @@map("notifications")
}

// Opt-out model: no row means enabled (product.md §45: "users and vendors
// can control channel preferences where appropriate" — the default must
// not silence anyone who never touched their settings).
model NotificationPreference {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  eventType NotificationEventType @map("event_type")
  channel   NotificationChannel
  isEnabled Boolean               @default(true) @map("is_enabled")
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType, channel])
  @@map("notification_preferences")
}

// Arch Phase 15. product.md §33: Telegram must not become part of the core
// business domain — TelegramUser only maps a Telegram identity to an
// optional platform User; every other module (enquiries, leads,
// notifications) continues to operate on User/Vendor/Lead exactly as before,
// unaware that Telegram was the origin (see LeadSource.TELEGRAM, already
// modeled in Arch Phase 9).
model TelegramUser {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  telegramUserId BigInt   @unique @map("telegram_user_id")
  userId         String?  @unique @map("user_id") @db.Uuid
  chatId         BigInt   @map("chat_id")
  username       String?
  firstName      String?  @map("first_name")
  lastName       String?  @map("last_name")
  languageCode   String?  @map("language_code")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user            User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversations   TelegramConversation[]
  messages        TelegramMessage[]
  weddingWebsites WeddingWebsite[]

  @@index([userId])
  @@map("telegram_users")
}

// Arch Phase 26 — discriminates which flow a TelegramConversation row is
// currently running. Added instead of a parallel conversation model so the
// existing "one open (non-COMPLETED) conversation per Telegram user"
// invariant (telegram.repository.ts's findOpenConversation) keeps working
// unmodified — starting a new flow while one is open resumes/overwrites
// the same row, exactly like /start already does today. See
// docs/12-stage-wedding-website.md's "Telegram flow design" decision.
enum TelegramFlowType {
  ENQUIRY
  WEDDING_WEBSITE
}

// product.md §35's 11 ENQUIRY states, persisted (not in-memory) — "do not
// rely only on in-memory state" is explicit. collectedData carries the
// enquiry being built up across states (categoryId, cityId, weddingDate,
// budget, guestCount, contactPhone, candidateVendorIds, selectedVendorId)
// since none of that has a durable home until the real Enquiry/Lead is
// created at CONFIRMING_ENQUIRY → COMPLETED.
//
// WW_* states (Arch Phase 26) are the wedding-website flow's own states,
// namespaced by prefix to avoid colliding with the ENQUIRY states above —
// both live in the same enum/column so a single TelegramConversation row
// can hold either flow, discriminated by flowType. collectedData's
// TypeScript shape is a union keyed by flowType (see
// telegram.conversation.types.ts) — text fields stay in collectedData
// until the draft WeddingWebsite row is created (at
// WW_SELECTING_TEMPLATE → WW_COLLECTING_COUPLE_NAMES), since photo
// uploads need a real weddingWebsiteId to attach to and can't defer to
// the end the way text fields do.
enum TelegramConversationState {
  START
  SELECTING_CATEGORY
  SELECTING_LOCATION
  COLLECTING_DATE
  COLLECTING_BUDGET
  COLLECTING_GUEST_COUNT
  COLLECTING_CONTACT
  MATCHING_VENDORS
  SELECTING_VENDOR
  CONFIRMING_ENQUIRY
  COMPLETED
  WW_SELECTING_TEMPLATE
  WW_COLLECTING_COUPLE_NAMES
  WW_COLLECTING_WEDDING_DATE
  WW_COLLECTING_VENUE
  WW_COLLECTING_BLESSINGS
  WW_COLLECTING_EVENTS
  WW_COLLECTING_PHOTOS
  WW_PREVIEW_READY
  WW_AWAITING_PAYMENT
  WW_PUBLISHED
}

model TelegramConversation {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  telegramUserId   String                    @map("telegram_user_id") @db.Uuid
  flowType         TelegramFlowType          @default(ENQUIRY) @map("flow_type")
  state            TelegramConversationState @default(START)
  collectedData    Json                      @default("{}") @map("collected_data")
  enquiryId        String?                   @map("enquiry_id") @db.Uuid
  weddingWebsiteId String?                   @map("wedding_website_id") @db.Uuid
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  telegramUser   TelegramUser      @relation(fields: [telegramUserId], references: [id], onDelete: Cascade)
  enquiry        Enquiry?          @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  weddingWebsite WeddingWebsite?   @relation(fields: [weddingWebsiteId], references: [id], onDelete: SetNull)
  messages       TelegramMessage[]

  @@index([telegramUserId])
  @@map("telegram_conversations")
}

enum TelegramMessageDirection {
  INBOUND
  OUTBOUND
}

// Architecture.md's "Message model" task — a log of what was actually
// exchanged, separate from TelegramConversation's current-state snapshot.
model TelegramMessage {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  telegramUserId    String                   @map("telegram_user_id") @db.Uuid
  conversationId    String?                  @map("conversation_id") @db.Uuid
  direction         TelegramMessageDirection
  telegramMessageId BigInt?                  @map("telegram_message_id")
  text              String?
  createdAt         DateTime                 @default(now()) @map("created_at")

  telegramUser TelegramUser          @relation(fields: [telegramUserId], references: [id], onDelete: Cascade)
  conversation TelegramConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([telegramUserId])
  @@index([conversationId])
  @@map("telegram_messages")
}

// product.md §36: "every incoming message/event should have an external
// identifier; store processed IDs" — Telegram's own update_id is globally
// sequential per bot, unique per delivery attempt (a genuine redelivery
// carries the same update_id). A unique-constraint INSERT-then-catch here
// is the exact same idempotency pattern Arch Phase 11's WebhookEvent uses
// for Razorpay.
model TelegramProcessedUpdate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  updateId  BigInt   @unique @map("update_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("telegram_processed_updates")
}

// Arch Phase 26 — ₹49 Instant Wedding Website. See
// docs/12-stage-wedding-website.md for the full feature spec and the
// architecture decisions this schema implements.

enum WeddingWebsiteTemplate {
  ROYAL_WEDDING
  MINIMAL_ELEGANT
  TRADITIONAL_INDIAN
}

enum WeddingWebsiteStatus {
  DRAFT
  PUBLISHED
}

// Exactly one of ownerUserId / ownerTelegramUserId is set per row,
// enforced at the application layer (Prisma has no portable
// exactly-one-of-two-columns constraint) — mirrors Media's existing
// vendorId/userId mutually-exclusive-owner pattern for REVIEW_PHOTO.
// ownerTelegramUserId exists because TelegramUser.userId is nullable — a
// Telegram user talking to the bot has no WedHub account/session unless
// they've separately signed up on the web app, and this feature must not
// require one (see docs/12-stage-wedding-website.md's "Ownership"
// decision).
model WeddingWebsite {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId         String?                @map("owner_user_id") @db.Uuid
  ownerTelegramUserId String?                @map("owner_telegram_user_id") @db.Uuid
  template            WeddingWebsiteTemplate @default(ROYAL_WEDDING)
  status              WeddingWebsiteStatus   @default(DRAFT)
  slug                String?                @unique

  brideName        String    @map("bride_name")
  groomName        String    @map("groom_name")
  weddingDate      DateTime? @map("wedding_date")
  weddingTime      String?   @map("wedding_time")
  venueName        String?   @map("venue_name")
  venueAddress     String?   @map("venue_address")
  googleMapsUrl    String?   @map("google_maps_url")
  shortDescription String?   @map("short_description")
  brideParents     String?   @map("bride_parents")
  groomParents     String?   @map("groom_parents")
  weddingHashtag   String?   @map("wedding_hashtag")
  contactInfo      String?   @map("contact_info")
  socialLinks      Json?     @map("social_links")

  coupleStory      String? @map("couple_story")
  brideDescription String? @map("bride_description")
  groomDescription String? @map("groom_description")
  howWeMet         String? @map("how_we_met")

  coverMediaId       String? @unique @map("cover_media_id") @db.Uuid
  couplePhotoMediaId String? @unique @map("couple_photo_media_id") @db.Uuid

  previewTokenHash String?   @map("preview_token_hash")
  previewCreatedAt DateTime? @map("preview_created_at")
  previewExpiresAt DateTime? @map("preview_expires_at")
  previewUsedAt    DateTime? @map("preview_used_at")

  publishedAt DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ownerUser             User?                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerTelegramUser     TelegramUser?          @relation(fields: [ownerTelegramUserId], references: [id], onDelete: Cascade)
  coverMedia            Media?                 @relation("WeddingWebsiteCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  couplePhotoMedia      Media?                 @relation("WeddingWebsiteCouplePhoto", fields: [couplePhotoMediaId], references: [id], onDelete: SetNull)
  events                WeddingWebsiteEvent[]
  gallery               Media[]                @relation("WeddingWebsiteGallery")
  rsvps                 WeddingWebsiteRsvp[]
  payments              Payment[]
  telegramConversations TelegramConversation[]

  @@index([ownerUserId])
  @@index([ownerTelegramUserId])
  @@index([status])
  @@map("wedding_websites")
}

model WeddingWebsiteEvent {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingWebsiteId String    @map("wedding_website_id") @db.Uuid
  name             String
  date             DateTime?
  time             String?
  venue            String?
  description      String?
  sortOrder        Int       @default(0) @map("sort_order")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  weddingWebsite WeddingWebsite @relation(fields: [weddingWebsiteId], references: [id], onDelete: Cascade)

  @@index([weddingWebsiteId])
  @@map("wedding_website_events")
}

enum WeddingWebsiteRsvpStatus {
  YES
  NO
  MAYBE
}

model WeddingWebsiteRsvp {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingWebsiteId String                   @map("wedding_website_id") @db.Uuid
  name             String
  attending        WeddingWebsiteRsvpStatus
  guestCount       Int?                     @map("guest_count")
  message          String?
  createdAt        DateTime                 @default(now()) @map("created_at")

  weddingWebsite WeddingWebsite @relation(fields: [weddingWebsiteId], references: [id], onDelete: Cascade)

  @@index([weddingWebsiteId])
  @@map("wedding_website_rsvps")
}

// -----------------------------------------------------------------------------
// Arch Phase 27 — Vendor GST Invoicing & Billing Engine
// -----------------------------------------------------------------------------

enum VendorInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum VendorPaymentMethod {
  UPI
  BANK_TRANSFER
  CASH
  CARD
  OTHER
}

model VendorBillingProfile {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId          String   @unique @map("vendor_id") @db.Uuid
  legalName         String?  @map("legal_name")
  tradeName         String?  @map("trade_name")
  gstin             String?  @map("gstin")
  pan               String?  @map("pan")
  address           String?  @map("address")
  city              String?  @map("city")
  state             String?  @map("state")
  stateCode         String?  @map("state_code")
  pincode           String?  @map("pincode")
  phone             String?  @map("phone")
  email             String?  @map("email")
  bankName          String?  @map("bank_name")
  accountName       String?  @map("account_name")
  accountNumber     String?  @map("account_number")
  ifscCode          String?  @map("ifsc_code")
  upiId             String?  @map("upi_id")
  invoicePrefix     String   @default("INV") @map("invoice_prefix")
