  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_billing_profiles")
}

model VendorInvoice {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId           String              @map("vendor_id") @db.Uuid
  leadId             String?             @map("lead_id") @db.Uuid
  invoiceNumber      String              @map("invoice_number")
  status             VendorInvoiceStatus @default(DRAFT)
  issueDate          DateTime            @map("issue_date") @db.Date
  dueDate            DateTime?           @map("due_date") @db.Date

  // Seller (Vendor) Snapshot at time of issue
  sellerBusinessName String              @map("seller_business_name")
  sellerLegalName    String?             @map("seller_legal_name")
  sellerGstin        String?             @map("seller_gstin")
  sellerPan          String?             @map("seller_pan")
  sellerAddress      String?             @map("seller_address")
  sellerCity         String?             @map("seller_city")
  sellerState        String?             @map("seller_state")
  sellerStateCode    String?             @map("seller_state_code")
  sellerPhone        String?             @map("seller_phone")
  sellerEmail        String?             @map("seller_email")
  sellerLogoKey      String?             @map("seller_logo_key")

  // Buyer (Client / Couple) Snapshot
  clientName         String              @map("client_name")
  clientPhone        String?             @map("client_phone")
  clientEmail        String?             @map("client_email")
  clientAddress      String?             @map("client_address")
  clientCity         String?             @map("client_city")
  clientState        String?             @map("client_state")
  clientStateCode    String?             @map("client_state_code")
  clientGstin        String?             @map("client_gstin")
  placeOfSupply      String              @map("place_of_supply")

  // Tax Mechanism & Financial Summary
  isInterState       Boolean             @default(false) @map("is_inter_state")
  currency           String              @default("INR")
  subtotal           Decimal             @db.Decimal(12, 2)
  totalDiscount      Decimal             @default(0) @map("total_discount") @db.Decimal(12, 2)
  taxableAmount      Decimal             @map("taxable_amount") @db.Decimal(12, 2)
  cgstAmount         Decimal             @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount         Decimal             @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount         Decimal             @default(0) @map("igst_amount") @db.Decimal(12, 2)
  totalTax           Decimal             @default(0) @map("total_tax") @db.Decimal(12, 2)
  roundOffAmount     Decimal             @default(0) @map("round_off_amount") @db.Decimal(10, 2)
  grandTotal         Decimal             @map("grand_total") @db.Decimal(12, 2)
  amountInWords      String?             @map("amount_in_words")
  paidAmount         Decimal             @default(0) @map("paid_amount") @db.Decimal(12, 2)
  balanceDue         Decimal             @map("balance_due") @db.Decimal(12, 2)

  // Payment Instructions Snapshot
  bankName           String?             @map("bank_name")
  accountName        String?             @map("account_name")
  accountNumber      String?             @map("account_number")
  ifscCode           String?             @map("ifsc_code")
  upiId              String?             @map("upi_id")
  notes              String?
  terms              String?

  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  vendor     Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  lead       Lead?                   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  items      VendorInvoiceItem[]
  payments   VendorInvoicePayment[]
  activities VendorInvoiceActivity[]

  @@unique([vendorId, invoiceNumber])
  @@index([vendorId, status])
  @@index([vendorId, issueDate])
  @@index([leadId])
  @@map("vendor_invoices")
}

model VendorInvoiceItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId     String   @map("invoice_id") @db.Uuid
  itemOrder     Int      @default(0) @map("item_order")
  description   String
  sacCode       String?  @map("sac_code")
  quantity      Decimal  @default(1) @db.Decimal(10, 2)
  unit          String   @default("Session")
  unitPrice     Decimal  @map("unit_price") @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  taxableAmount Decimal  @map("taxable_amount") @db.Decimal(12, 2)
  gstRate       Decimal  @map("gst_rate") @db.Decimal(5, 2)
  cgstRate      Decimal  @default(0) @map("cgst_rate") @db.Decimal(5, 2)
  cgstAmount    Decimal  @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstRate      Decimal  @default(0) @map("sgst_rate") @db.Decimal(5, 2)
  sgstAmount    Decimal  @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  igstRate      Decimal  @default(0) @map("igst_rate") @db.Decimal(5, 2)
  igstAmount    Decimal  @default(0) @map("igst_amount") @db.Decimal(12, 2)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)

  invoice VendorInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("vendor_invoice_items")
}

model VendorInvoicePayment {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId            String              @map("invoice_id") @db.Uuid
  amount               Decimal             @db.Decimal(12, 2)
  paymentMethod        VendorPaymentMethod @default(UPI) @map("payment_method")
  transactionReference String?             @map("transaction_reference")
  paymentDate          DateTime            @default(now()) @map("payment_date")
  notes                String?
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  invoice VendorInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("vendor_invoice_payments")
}

model VendorInvoiceActivity {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  action      String
  performedBy String?  @map("performed_by") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  invoice VendorInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("vendor_invoice_activities")
}

