# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# --- Database ---
# Port 5433 (not the Postgres default 5432) because this machine already runs a
# native Postgres Windows service bound to 5432 — see docker-compose.yml.
DATABASE_URL=postgresql://wedhub:wedhub_dev_password@localhost:5433/wedhub_dev

# --- Auth (used starting Arch Phase 2) ---
JWT_SECRET=change-me-dev-secret
JWT_REFRESH_SECRET=change-me-dev-refresh-secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL_DAYS=30

# --- Redis (used starting Arch Phase 14) ---
REDIS_URL=redis://localhost:6379

# --- Object storage / Cloudflare R2 (used starting Arch Phase 6) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Payments / Razorpay (used starting Arch Phase 11) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Telegram (used starting Arch Phase 15) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- URLs ---
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
