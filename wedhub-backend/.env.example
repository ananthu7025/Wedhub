# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# --- Database ---
# Port 5433 (not the Postgres default 5432) because this machine already runs a
# native Postgres Windows service bound to 5432 — see docker-compose.yml.
DATABASE_URL=postgresql://wedhub:wedhub_dev_password@localhost:5433/wedhub_dev

# --- Auth (used starting Arch Phase 2) ---
JWT_SECRET=change-me-dev-secret
JWT_REFRESH_SECRET=change-me-dev-refresh-secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL_DAYS=30

# --- Redis (required starting Arch Phase 6 — media processing queue) ---
REDIS_URL=redis://localhost:6379

# --- Object storage / Cloudflare R2 (required starting Arch Phase 6 for real uploads) ---
# Create a bucket at https://dash.cloudflare.com/?to=/:account/r2 and an API token
# with R2 read/write access. Without these, media upload-request validation and
# album CRUD still work, but signed uploads and the processing worker will fail
# with a clear "Object storage is not configured" error.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Media limits (Arch Phase 6) ---
MEDIA_MAX_IMAGE_SIZE_MB=10
MEDIA_MAX_VIDEO_SIZE_MB=100
MEDIA_MAX_PORTFOLIO_ITEMS=50

# --- Payments / Razorpay (used starting Arch Phase 11) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Telegram (used starting Arch Phase 15) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- URLs ---
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# --- Rate limit overrides (optional, dev/CI only — see rate-limit.middleware.ts) ---
# Unset in production; the real limits (10/20/10/5) apply automatically.
# Uncomment during heavy local/CI Playwright runs to avoid tripping the
# real in-memory limiters (see frontenddocs/10-risks-and-open-questions.md #14).
# LOGIN_RATE_LIMIT_MAX=1000
# REGISTER_RATE_LIMIT_MAX=1000
# ENQUIRY_RATE_LIMIT_MAX=1000
# REVIEW_RATE_LIMIT_MAX=1000
