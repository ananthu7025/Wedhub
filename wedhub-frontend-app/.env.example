# Backend base URL — safe to expose to the client
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only override if the backend's internal address ever differs from
# the public one (e.g. container networking). Falls back to
# NEXT_PUBLIC_API_URL when unset.
# API_URL=http://backend:4000

# Telegram bot deep-link CTA (see frontenddocs/07-stage-growth-and-hardening.md,
# Frontend Arch Phase 11a) — set once the production bot username is confirmed.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=VendorMatefinderBot

# R2 public media base URL — must match wedhub-backend's R2_PUBLIC_BASE_URL
# exactly (see wedhub-backend/src/integrations/storage/r2.client.ts's
# getPublicUrl(): `${base}/${objectKey}`, no signing). Needed client-side
# to resolve portfolio/album media object keys to displayable image URLs
# (see frontenddocs/10-risks-and-open-questions.md, Open Question 7).
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://pub-7116e74b9a3d44a1ab03594911f56ad8.r2.dev
