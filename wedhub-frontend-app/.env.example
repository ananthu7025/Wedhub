# Backend base URL — safe to expose to the client
NEXT_PUBLIC_API_URL=http://localhost:4000

# This app's own public origin — used for metadataBase (resolves relative
# canonical/OG URLs), sitemap.ts, and robots.ts (Arch Phase 17 SEO). Must be
# the real production domain in production, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only override if the backend's internal address ever differs from
# the public one (e.g. container networking). Falls back to
# NEXT_PUBLIC_API_URL when unset.
# API_URL=http://backend:4000

# Telegram bot deep-link CTA (see frontenddocs/07-stage-growth-and-hardening.md,
# Frontend Arch Phase 11a) — set once the production bot username is confirmed.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=VendorMatefinderBot

# R2 public media base URL — must match wedhub-backend's R2_PUBLIC_BASE_URL
# exactly (see wedhub-backend/src/integrations/storage/r2.client.ts's
# getPublicUrl(): `${base}/${objectKey}`, no signing). Needed client-side
# to resolve portfolio/album media object keys to displayable image URLs
# (see frontenddocs/10-risks-and-open-questions.md, Open Question 7).
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://pub-7116e74b9a3d44a1ab03594911f56ad8.r2.dev

# --- Razorpay Checkout.js (Frontend Arch Phase 7) ---
# Public key ID only (never the secret) — loaded client-side by
# app/(vendor)/vendor/subscription/UpgradeButton.tsx. Leave unset to render
# the "payments not configured in this environment" state instead of a
# broken checkout button.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Google Sign-In (Google Identity Services) ---
# OAuth 2.0 Client ID from Google Cloud Console — same value as the
# backend's GOOGLE_CLIENT_ID. Public by design (it identifies the app to
# Google, not a secret). Add this app's real origin(s) as an Authorized
# JavaScript origin on that Google Cloud client. Loaded client-side by
# components/shared/GoogleSignInButton.tsx; leave unset to render the
# "Google sign-in not configured" state instead of a broken button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
