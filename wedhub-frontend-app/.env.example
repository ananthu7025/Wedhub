# Backend base URL — safe to expose to the client
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only override if the backend's internal address ever differs from
# the public one (e.g. container networking). Falls back to
# NEXT_PUBLIC_API_URL when unset.
# API_URL=http://backend:4000

# Telegram bot deep-link CTA (see frontenddocs/07-stage-growth-and-hardening.md,
# Frontend Arch Phase 11a) — set once the production bot username is confirmed.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=VendorMatefinderBot
